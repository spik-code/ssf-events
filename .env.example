# ── SSF Events — environment template ───────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ImageKit — https://imagekit.io/dashboard/developer/api-keys
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Resend — enquiry email notification. Optional: the enquiry still saves
# without it, the email is just skipped.
#   1. Sign up at https://resend.com and create a key at /api-keys (starts "re_")
#   2. RESEND_API_KEY = that key
#   3. ENQUIRY_NOTIFICATION_EMAIL = the inbox new enquiries should reach
#   4. ENQUIRY_FROM_EMAIL = the "from" address. onboarding@resend.dev works for
#      testing; for production, verify a domain in Resend and use e.g. hello@yourdomain
RESEND_API_KEY=
ENQUIRY_NOTIFICATION_EMAIL=srisaifloraevent@gmail.com
ENQUIRY_FROM_EMAIL=onboarding@resend.dev

# Business / public config
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919353568207
NEXT_PUBLIC_CONTACT_PHONE=+91 93535 68207
NEXT_PUBLIC_CONTACT_EMAIL=srisaifloraevent@gmail.com
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/ssf_events/

# Google Business Profile reviews (Places API)
GOOGLE_PLACES_API_KEY=
CRON_SECRET=

# Owner app push alerts: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
